{
	# Let's Encrypt only gives certificates for a bare IP address on its short-lived profile. Caddy renews them by itself.
	cert_issuer acme {
		profile shortlived
	}
	# Clients send no server name when connecting to a bare IP address, and from inside its container Caddy can't work
	# out the address they used, so without this the TLS handshake fails.
	default_sni {$GAME_ADDRESS}
}

{$SITE_ADDRESS} {
	# Minecraft can't send a password when it fetches a resource pack, so this path has no password. It's a long random
	# token instead, which nobody learns until they've passed the game's own password.
	@pack path /pack/{$PACK_TOKEN}/*
	handle @pack {
		uri strip_prefix /pack/{$PACK_TOKEN}
		reverse_proxy prod:25567
	}

	# The updater in friends' games has no password either, so this is the same idea: the token is only in the pack, which is behind the
	# password. Everything here is signed, and it's only the mods anyone downloading the pack already gets.
	@update path /update/{$UPDATE_TOKEN}/*
	handle @update {
		uri strip_prefix /update/{$UPDATE_TOKEN}
		header Cache-Control no-store
		root * /srv/download/update
		file_server
	}

	# Other machines' builders, which have tokens of their own that the agent checks. Nothing's served here unless one's been added.
	handle /worker/* {
		reverse_proxy agent:8790 {
			flush_interval -1
		}
	}

	handle {
		# Written by scripts/set-password.sh. A missing file stops the site from starting, rather than opening it.
		import /etc/caddy/auth/auth.caddy

		header {
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			Referrer-Policy no-referrer
			X-Content-Type-Options nosniff
			Cache-Control no-store
		}

		handle /LivingMod.zip {
			header Content-Disposition "attachment; filename=LivingMod.zip"
			root * /srv/download
			file_server
		}

		# The page about this world. It's all plain files, written ahead of time by the world service in compose.yaml, and it must never go through
		# templates, because builders' words end up in these files. /world/ is spoiler-free, and /world/spoilers/ has everything. See orchestrator/world_page.py.
		redir /world /world/
		handle_path /world/* {
			header Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			# A picture's address changes if the picture does, so these can be kept.
			header /spoilers/img/* Cache-Control "private, max-age=2592000, immutable"
			root * /srv/world
			file_server
		}

		handle {
			root * /srv/www
			templates
			file_server
		}
	}
}

# The game servers have no route to the internet, so their pack servers are reached through here. These two are only
# published on this machine, for test clients and bots.
:25567 {
	reverse_proxy prod:25567
}

:25568 {
	reverse_proxy shadow:25567
}
