{
  "id": "lore",
  "phase": 1,
  "summary": "Test fixture that uses every content type: knowledge, gated and guessable recipes, a plant, a mob and a biome.",
  "blocks": {
    "rune_crucible": {"family": "machine", "display": "Rune Crucible", "texture": "rune_crucible", "tool": "pickaxe"},
    "moss_cap": {"family": "plant", "display": "Moss Cap", "texture": "moss_cap"},
    "glow_cap": {"family": "glow_plant", "display": "Glow Cap", "texture": "glow_cap", "retired": true},
    "rune_stone": {"family": "stone", "display": "Rune Stone", "texture": "rune_stone", "tool": "pickaxe"},
    "rune_ore": {"family": "ore", "display": "Rune Ore", "texture": "rune_ore", "tool": "pickaxe", "tool_level": "stone",
                 "drops": {"item": "rune_dust", "count": [2, 3]}}
  },
  "ores": [
    {"id": "rune_ore_v1", "block": "rune_ore", "replaces": ["minecraft:stone", "minecraft:deepslate"],
     "veinsPerChunk": 3, "veinSize": 6, "minY": -40, "maxY": 50}
  ],
  "items": {
    "rune_dust": {"display": "Rune Dust", "texture": "rune_dust"},
    "rune_berry": {"display": "Rune Berry", "texture": "rune_berry", "retired": true,
                   "components": {"minecraft:food": {"nutrition": 4, "saturation": 2.4}, "minecraft:consumable": {"consume_seconds": 1.2}}},
    "moss_seed": {"display": "Moss Seed", "texture": "moss_seed", "retired": true,
                  "places": {"block": "$block:moss_cap", "on": ["minecraft:smooth_stone"]}},
    "rune_gem": {"display": "Rune Gem", "texture": "rune_gem"},
    "rune_tablet": {"display": "Rune Tablet", "texture": "rune_tablet"},
    "rune_shard": {"display": "Rune Shard", "texture": "rune_shard"},
    "rune_salt": {"display": "Rune Salt", "texture": "rune_salt"}
  },
  "knowledge": {
    "gem_cutting": {
      "title": "On Cutting Gems",
      "text": "Two measures of dust, pressed together, will make a gem if you know how to ask them.",
      "routes": [{"type": "read", "id": "$item:rune_tablet"}]
    },
    "shard_lore": {
      "title": "The Broken Saying",
      "text": "Pieced together from three shards.",
      "routes": [{"type": "fragments", "id": "$item:rune_shard", "needed": 3, "requires": ["gem_cutting"]}]
    }
  },
  "recipes": {
    "rune_crucible": {
      "mode": "open",
      "json": {
        "type": "minecraft:crafting_shapeless",
        "ingredients": ["minecraft:cauldron", "minecraft:amethyst_shard"],
        "result": {"id": "$block:rune_crucible", "count": 1}
      }
    },
    "rune_tablet": {
      "mode": "open",
      "json": {
        "type": "minecraft:crafting_shapeless",
        "ingredients": ["minecraft:paper", "minecraft:amethyst_shard"],
        "result": {"id": "$item:rune_tablet", "count": 1}
      }
    },
    "rune_shard": {
      "mode": "open",
      "json": {
        "type": "minecraft:crafting_shapeless",
        "ingredients": ["minecraft:flint", "minecraft:amethyst_shard"],
        "result": {"id": "$item:rune_shard", "count": 1}
      }
    },
    "rune_gem": {
      "mode": "known",
      "route": "gem_cutting",
      "json": {
        "type": "minecraft:crafting_shapeless",
        "ingredients": ["$item:rune_dust", "$item:rune_dust"],
        "result": {"id": "$item:rune_gem", "count": 1}
      }
    },
    "rune_salt": {
      "mode": "guessable",
      "machine": "crucible",
      "feedback": "The crucible hums louder the closer you are.",
      "inputs": [{"item": "$item:rune_dust", "count": 1}, {"item": "$item:rune_gem", "count": 1}],
      "output": {"item": "$item:rune_salt", "count": 1}
    }
  },
  "mobs": {
    "rune_crab": {
      "category": "creature",
      "display": "Rune Crab",
      "model": "rune_crab",
      "behaviour": "skittish",
      "health": 8,
      "damage": 0,
      "speed": 0.25,
      "width": 0.8,
      "height": 0.6,
      "drops": {"item": "rune_dust", "count": [1, 2]},
      "spawn": {"weight": 10, "light": "any", "minY": 40, "maxY": 200, "cap": 3, "underground": false, "biomes": []}
    }
  },
  "plants": [
    {"id": "moss_cap_v1", "block": "moss_cap", "on": ["minecraft:grass_block"], "perChunk": 1.5, "minY": 40, "maxY": 200, "underground": false, "biomes": []}
  ],
  "ruins": {
    "rune_shrine": {
      "id": "rune_shrine_v1",
      "parts": [
        {"x": 7, "y": 0, "z": 7, "block": "$block:rune_stone"},
        {"x": 8, "y": 0, "z": 7, "block": "minecraft:chest"},
        {"x": 7, "y": 1, "z": 7, "block": "$block:rune_stone"}
      ],
      "on": ["minecraft:grass_block", "minecraft:dirt", "minecraft:stone", "minecraft:sand", "minecraft:gravel"],
      "replaces": ["minecraft:air", "minecraft:short_grass", "minecraft:water"],
      "chance": 0.6,
      "minY": 20,
      "maxY": 200,
      "underground": false,
      "biomes": [],
      "loot": {"type": "minecraft:chest", "pools": [{"rolls": 1, "entries": [{"type": "minecraft:item", "name": "$item:rune_shard"}]}]}
    }
  },
  "biomes": {
    "rune_meadow": {
      "base": "minecraft:plains",
      "effects": {"grass_color": "#2e8b57", "foliage_color": "#2e8b57"},
      "proportion": 0.4
    }
  }
}
